PORT=4000

# MongoDB (workspace storage) — leave blank to use local data/users.json in dev.
# In production (Vercel) this MUST be set; the project-folder filesystem is read-only.
MONGODB_URI=
MONGODB_DB_NAME=smartbooks
MONGODB_USERS_COLLECTION=users

# Clerk Backend API — used to send team-member invitation emails.
# Get this from the Clerk dashboard → API Keys → "Secret keys".
# If left blank the backend still records invites, but no email is sent;
# the admin can copy the sign-up URL from the response and share it manually.
CLERK_SECRET_KEY=

# Frontend origin used as the redirect target after a Clerk invitation is
# accepted. Example: https://smartbooks-frontend.vercel.app (no trailing slash).
FRONTEND_URL=
